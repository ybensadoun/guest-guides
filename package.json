{
  "name": "guest-guides",
  "version": "1.0.0",
  "description": "Guest guides: one engine, many sites. Ca La Kimberly is site #1.",
  "scripts": {
    "dev": "node engine/scripts/run.js dev",
    "build": "node engine/scripts/run.js build",
    "check": "node engine/scripts/run.js check",
    "preview": "node engine/scripts/run.js preview",
    "preview-file": "node engine/scripts/run.js preview-file",
    "sites": "node engine/scripts/run.js sites",
    "check-places": "NODE_USE_ENV_PROXY=1 node --no-warnings engine/scripts/check-places.js",
    "check-guides": "node worker/check-guides.mjs",
    "refresh-events": "node worker/guide-worker.mjs --refresh-events",
    "guide:push": "node worker/guide-sync.mjs push",
    "guide:pull": "node worker/guide-sync.mjs pull",
    "build-viewer": "vite build --config engine/vite.viewer.config.js",
    "build-guide": "node engine/scripts/build-guide.mjs"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "maplibre-gl": "^6.11.2",
    "qrcode-generator": "^2.0.4"
  },
  "private": true,
  "type": "module"
}
